  },
  "CorporateHosting": {
    "Required": true
  },
  "UatAutomation": {
    "CleanupEnabled": false
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "Mode": "Entra",
    "Issuer": "FieldVisit.Corporate",
    "Audience": "FieldVisit.Corporate.Users",
